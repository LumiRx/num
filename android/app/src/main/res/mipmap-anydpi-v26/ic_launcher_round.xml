<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon. The launcher masks BOTH layers to a circle, squircle or
     rounded square depending on the device, and only the centre 66 of 108dp is
     guaranteed to survive. The foreground therefore carries the wordmark alone,
     scaled inside that safe zone; "BY 5ARZ" is deliberately absent because it is
     illegible at 48dp and the mask would cut it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>

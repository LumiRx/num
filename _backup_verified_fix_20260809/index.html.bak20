<style>
/* App band - the download block on the home page. Lives here because assets/site.css
   is served by the other worker and cannot be edited from this repo. */
.appband{margin-top:16px;background:linear-gradient(140deg,var(--pri-xl),#fff 62%);border:1px solid var(--line);border-radius:26px;box-shadow:var(--shadow);padding:40px;display:grid;grid-template-columns:1fr auto;gap:40px;align-items:center}
.appband .lead{max-width:54ch;margin-top:12px}
.ticks{list-style:none;margin:26px 0 0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:11px 26px;max-width:640px}
.ticks li{display:flex;align-items:flex-start;gap:10px;font-size:15px;color:var(--ink2);font-weight:600}
.ticks li::before{content:"\2713";flex:none;width:20px;height:20px;margin-top:1px;border-radius:50%;background:var(--pri-l);color:var(--pri-d);font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center}
.appband-cta{margin-top:30px;display:flex;gap:12px;flex-wrap:wrap}
.appband-note{margin-top:14px;font-size:13.5px;color:var(--slate)}
.appband-qr{flex:none;text-align:center;background:#fff;border:1px solid var(--line);border-radius:20px;padding:18px;box-shadow:0 10px 30px rgba(10,26,36,.07)}
.appband-qr img{width:150px;height:150px;display:block;border-radius:10px}
.appband-qr span{display:block;margin-top:10px;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--slate)}
.ic svg{width:22px;height:22px;fill:none;stroke:var(--pri-d);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.ic.amber svg{stroke:#B07A22}
@media(max-width:860px){.appband{grid-template-columns:1fr;padding:28px;gap:26px}.appband-qr{justify-self:start}.ticks{grid-template-columns:1fr}}
</style>

<header class="wrap hero">
  <div class="hero-grid">
    <div>
      <span class="pill">✦ Live in 38 countries</span>
      <h1 class="h1" style="margin-top:18px">A concierge in your pocket, anywhere you&nbsp;land.</h1>
      <p class="sub">NUM plans your trip in a simple chat and books <b>real, verified</b> local places — more than half a million of them, across 77 destinations. Any language, any hour.</p>
      <div class="cta">
        <a class="btn pri lg" href="/get/">Get the app</a>
        <a class="btn ghost lg" href="https://line.me/R/ti/p/@799pyrus" data-alt="line">Message Num on LINE</a>
      </div>
      <div class="trust">
        <span><span class="tk">✓</span> 77 destinations, 38 countries</span>
        <span><span class="tk">✓</span> Real, verified places</span>
        <span><span class="tk">✓</span> Any language, 24/7</span>
      </div>
    </div>
    <div class="showcase">
      <img class="hero-photo" src="/assets/hero.jpg" alt="A traveler using the NUM concierge">
      <div class="phone">
        <div class="notch"></div>
        <div class="screen">
          <div class="chead"><span class="cav">N</span><div><div class="cname">NUM concierge</div><div class="cverif">● online now</div></div></div>
          <div class="bub them">Just landed. Dinner tonight? 🌙</div>
          <div class="bub me">Somewhere romantic, walkable</div>
          <div class="bub card"><div class="cardtop"><b>Verified pick</b><span class="vch">✓ VERIFIED</span></div>Candlelit terrace · 6 min from you<button class="minibtn">Book a table</button></div>
          <div class="bub me">Perfect — 2 at 8pm 🙌</div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- coverage -->

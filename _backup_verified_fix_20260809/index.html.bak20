    </div>
  </div>
</section>

<!-- LIVE ON LINE -->
<section class="wrap reveal" id="line">
  <div class="center" style="max-width:620px;margin:0 auto 24px">
    <span class="kicker">Start in ten seconds</span>
    <h2 class="h2" style="margin-top:10px">Two ways in. Both live today.</h2>
  </div>

  <div class="appband">
    <div>
      <span class="kicker">The app</span>
      <h3 class="h2" style="margin-top:10px">The whole trip, in one thread.</h3>
      <p class="lead">Plans, bookings, a calendar that catches clashes and more than half a million verified places - on your home screen in two taps. No app store, no download.</p>
      <ul class="ticks">
        <li>One thread for the whole trip</li>
        <li>Real places, verified</li>
        <li>Bookings held and confirmed</li>
        <li>A calendar that catches clashes</li>
        <li>Plans you build with friends</li>
        <li>Any language, any hour</li>
      </ul>
      <div class="appband-cta">
        <a class="btn pri lg" href="/get/">Get the app</a>
        <button class="btn ghost lg" type="button" data-share>Share the link</button>
      </div>
      <p class="appband-note">itsnum.com/get &nbsp;&middot;&nbsp; iPhone and Android &nbsp;&middot;&nbsp; <a href="/app/" style="color:var(--pri-d);font-weight:700">See everything it does</a></p>
    </div>
    <div class="appband-qr">
      <img src="/app/qr-get.png" alt="QR code for itsnum.com/get" width="150" height="150">
      <span>Scan to install</span>
    </div>
  </div>

  <div class="ctaband" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:40px;text-align:left;">
    <div style="background:#ffffff;border-radius:22px;padding:12px;box-shadow:0 16px 44px rgba(0,0,0,.22);flex:0 0 auto;">
      <img src="data:image/png;base64," alt="Scan to add NUM on LINE — @799pyrus" width="216" height="216" style="display:block;border-radius:12px;">
    </div>
    <div style="max-width:440px;">
      <h2 style="margin:0;">Chat with Num on LINE</h2>
      <p style="margin:10px 0 18px;">Scan the code or tap the button, say hi, and ask for anything — "best massage near me", "seafood dinner tonight" — in any language. Nothing to install.</p>
      <a class="btn pri lg" href="https://line.me/R/ti/p/@799pyrus">Add Num on LINE</a>
      <p style="margin-top:12px;opacity:.85;font-size:14px;">LINE ID: <b>@799pyrus</b> &nbsp;·&nbsp; WhatsApp and WeChat next</p>
    </div>
  </div>
</section>



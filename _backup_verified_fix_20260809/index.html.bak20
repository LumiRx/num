<!-- ── Sign in ─────────────────────────────────────────────────────────────
     Self-contained: own CSS namespace (nsi-), no dependency on assets/site.css.
     Posts to /api/accounts/login (num-accounts Worker, already live).
     No password anywhere — a one-time link arrives by email, good for 15 min. -->
<style>
.nsi-ov{position:fixed;inset:0;z-index:10000;background:rgba(24,26,48,.55);backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;padding:20px}
.nsi-ov.open{display:flex}
.nsi-card{background:#fff;border-radius:20px;max-width:420px;width:100%;padding:30px 28px 26px;box-shadow:0 30px 80px rgba(30,33,70,.35);position:relative;font-family:'Plus Jakarta Sans',system-ui,sans-serif}
.nsi-x{position:absolute;top:14px;right:16px;border:0;background:transparent;font-size:22px;line-height:1;color:#9AA0C0;cursor:pointer}
.nsi-x:hover{color:#3A3E5C}
.nsi-eyebrow{font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#6366F1}
.nsi-h{font-size:23px;font-weight:800;color:#1B1E3B;margin:8px 0 6px;letter-spacing:-.02em}
.nsi-p{font-size:14px;line-height:1.55;color:#5E6485;margin:0 0 18px}
.nsi-in{width:100%;box-sizing:border-box;border:1.5px solid #DDE0FB;border-radius:12px;padding:13px 15px;font-size:15px;font-family:inherit;color:#1B1E3B;outline:none;transition:border-color .15s}
.nsi-in:focus{border-color:#6366F1}
.nsi-btn{width:100%;margin-top:12px;border:0;border-radius:12px;padding:14px;font-size:15px;font-weight:700;font-family:inherit;color:#fff;cursor:pointer;background:linear-gradient(135deg,#6366F1,#8B5CF6);transition:opacity .15s}
.nsi-btn:hover{opacity:.92}
.nsi-btn:disabled{opacity:.55;cursor:default}
.nsi-note{font-size:12.5px;line-height:1.5;color:#8A90AE;margin:14px 0 0;text-align:center}
.nsi-note a{color:#6366F1;text-decoration:none;font-weight:600}
.nsi-ok{text-align:center;padding:8px 0 2px}
.nsi-ok .nsi-tick{font-size:40px;line-height:1}
.nsi-err{font-size:13px;color:#D14343;margin:10px 0 0;display:none}
</style>
<div class="nsi-ov" id="nsi-ov" onclick="if(event.target===this)closeSignin()">
  <div class="nsi-card" role="dialog" aria-modal="true" aria-label="Sign in to NUM">
    <button class="nsi-x" onclick="closeSignin()" aria-label="Close">&times;</button>

    <div id="nsi-form">
      <div class="nsi-eyebrow">NUM account</div>
      <h3 class="nsi-h">Sign in</h3>
      <p class="nsi-p">Enter the email your NUM account uses. We'll send a one-time sign-in link — no password to remember.</p>
      <form onsubmit="submitSignin();return false;">
        <input class="nsi-in" id="nsi-email" type="email" autocomplete="email" placeholder="you@yourbusiness.com" required>
        <button class="nsi-btn" id="nsi-go" type="submit">Send my sign-in link</button>
      </form>
      <p class="nsi-err" id="nsi-err">Something went wrong. Please try again in a moment.</p>
      <p class="nsi-note">Don't have an account yet? <a href="/claim/">Claim your business — free</a></p>
    </div>

    <div id="nsi-sent" style="display:none">
      <div class="nsi-ok">
        <div class="nsi-tick"><svg viewBox="0 0 24 24" style="width:30px;height:30px;fill:none;stroke:#0B7C63;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round"><rect x="2.8" y="5" width="18.4" height="14" rx="3"/><path d="m3.6 7.4 7.3 5.2a2 2 0 0 0 2.2 0l7.3-5.2"/></svg></div>
        <h3 class="nsi-h">Check your email</h3>
        <p class="nsi-p" style="margin-bottom:6px">If that address has NUM access, a sign-in link is on its way. It works once and expires in 15&nbsp;minutes.</p>
      </div>
      <p class="nsi-note">Wrong address? <a href="#" onclick="resetSignin();return false;">Try another one</a></p>
    </div>

  </div>
</div>
<script>
(function(){
  function $(id){ return document.getElementById(id); }

  window.openSignin = function(){
    resetSignin();
    $('nsi-ov').classList.add('open');
    setTimeout(function(){ var e=$('nsi-email'); if(e) e.focus(); }, 60);
  };
  window.closeSignin = function(){ $('nsi-ov').classList.remove('open'); };
  window.resetSignin = function(){
    $('nsi-form').style.display=''; $('nsi-sent').style.display='none';
    $('nsi-err').style.display='none'; var e=$('nsi-email'); if(e) e.value='';
  };

  window.submitSignin = async function(){
    var v = ($('nsi-email').value || '').trim();
    if(!v) return;
    var btn = $('nsi-go');
    btn.disabled = true; btn.textContent = 'Sending…';
    $('nsi-err').style.display='none';
    try{
      await fetch('/api/accounts/login', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ email: v })
      });
      $('nsi-form').style.display='none'; $('nsi-sent').style.display='';
    }catch(e){
      $('nsi-err').style.display='';
    }
    btn.disabled = false; btn.textContent = 'Send my sign-in link';
  };

  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape') closeSignin();
  });

  // Already signed in? Swap "Sign in" for a way back into the console.
  (async function(){
    try{
      var res = await fetch('/api/accounts/me', { credentials:'same-origin' });
      var me  = await res.json();
      if(!me || !me.signed_in) return;
      var name = (me.display_name || me.email || 'your account');
      var slot = $('signin-slot');
      if(slot) slot.innerHTML = '<a href="/console/" title="Signed in as ' + name + '">Console &rarr;</a>';
      var m = $('signin-slot-m');
      if(m){ m.textContent = 'Console →'; m.setAttribute('href','/console/'); m.onclick = null; }
    }catch(e){}
  })();

  /* In-site convenience only: ?signin=1 opens the box for someone already on this page.
     Do NOT put itsnum.com/?signin=1 in an email or a QR code — the Cloudflare route
     "itsnum.com/" matches the bare root and nothing else, so a query string on the root
     falls through to the older site worker and serves a different page entirely.
     External links go to /signin/, which is a routed path. */
  if(/[?&]signin=1/.test(location.search)) window.addEventListener('load', openSignin);
})();
</script>

<script>
/* One link, everywhere: the native share sheet on a phone, the clipboard on a desktop. */
(function () {
  var U = 'https://itsnum.com/get';
  var nodes = document.querySelectorAll('[data-share]');
  for (var i = 0; i < nodes.length; i++) {
    (function (b) {
      b.addEventListener('click', function () {
        var t = b.textContent;
        function flash(m) { b.textContent = m; setTimeout(function () { b.textContent = t; }, 1800); }
        if (navigator.share) {
          navigator.share({
            title: 'Num - your travel concierge',
            text: 'Num plans your trip and books real, verified places. Install it here:',
            url: U
          }).catch(function () {});
          return;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(U).then(function () { flash('Link copied'); }, function () { flash(U); });
          return;
        }
        flash(U);
      });
    })(nodes[i]);
  }
})();
</script>

<script src="/js/track.js" defer></script>
</body>
</html>

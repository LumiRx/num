<script src="/assets/site.js"></script>
<script>
/* No .reveal anywhere on this page, deliberately. Paid traffic lands here cold
   and every element has to be on screen the instant the page paints; .reveal
   sets opacity:0 and waits for script. Nothing here is worth that risk. */

/* /api/capture writes the row and returns; it does not send mail. So the page
   itself has to be the receipt — hand over the install link on the spot rather
   than promising an inbox we do not deliver to. */
window.addEventListener('num:capture', function () {
  var f = document.getElementById('su-form'), d = document.getElementById('su-done');
  if (!f || !d) return;
  f.hidden = true;
  d.hidden = false;
  try { d.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); } catch (e) {}
});

/* Share the install link. */
(function () {
  var U = 'https://itsnum.com/get';
  var nodes = document.querySelectorAll('[data-share]');
  for (var i = 0; i < nodes.length; i++) {
    (function (b) {
      b.addEventListener('click', function () {
        var t = b.textContent;
        function flash(m) { b.textContent = m; setTimeout(function () { b.textContent = t; }, 1800); }
        if (navigator.share) {
          navigator.share({ title: 'Num - your travel concierge', text: 'Num plans your trip and books real, verified places. Install it here:', url: U }).catch(function () {});
          return;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(U).then(function () { flash('Link copied'); }, function () { flash(U); });
          return;
        }
        flash(U);
      });
    })(nodes[i]);
  }
})();

/* This page is the destination for paid traffic and it now carries a full site
   nav, so people leave it. Without this the campaign tag dies at the first hop
   and the conversion is recorded as direct. Carry the query across every
   internal link so per-channel numbers survive the whole funnel. */
(function () {
  var q = location.search;
  if (!q || q.length < 2) return;
  var params = new URLSearchParams(q), carry = new URLSearchParams();
  params.forEach(function (v, k) {
    if (/^(utm_|gclid|fbclid|ttclid|msclkid|ref$)/i.test(k)) carry.set(k, v);
  });
  var tail = carry.toString();
  if (!tail) return;
  document.querySelectorAll('a[href^="/"]').forEach(function (a) {
    var h = a.getAttribute('href');
    if (!h || h.charAt(0) !== '/' || h.indexOf('#') === 0) return;
    a.setAttribute('href', h + (h.indexOf('?') === -1 ? '?' : '&') + tail);
  });
})();
</script>

</body>
</html>

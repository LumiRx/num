<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Num — your VIP travel concierge</title>
<meta name="description" content="Num is a travel concierge you message. It plans your day, books the table and answers in your language, in 77 destinations across 38 countries.">
<link rel="canonical" href="https://itsnum.com/vip/">
<meta name="theme-color" content="#F6FAF9">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

<meta property="og:type" content="website">
<meta property="og:url" content="https://itsnum.com/vip/">
<meta property="og:title" content="Num — your VIP travel concierge">
<meta property="og:description" content="Message it once. It plans the day, books the table and keeps the whole trip in one thread.">
<meta property="og:image" content="https://itsnum.com/assets/og.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://itsnum.com/assets/og.jpg">

<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/site.css">

<style>
/* ── /vip: page-local only. Palette, type scale, buttons, cards, nav, footer and
      rhythm all come from site.css so this page reads as part of itsnum.com
      rather than a separate landing page. Nothing below redefines a colour
      site.css already owns.

      Class names here are deliberately prefixed or unusual. site.css already
      owns .signup (a two-column wizard grid) and .step (a keyframe animation),
      and reusing either name silently breaks the page. ─────────────────────── */

/* icons are drawn, never typed. site.css sizes the .ic tile but not the svg
   inside it, so without this every icon fills its tile as a black block. */
.ic svg{width:22px;height:22px;fill:none;stroke:var(--pri-d);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.ic.amber svg{stroke:#B07A22}
.trust svg{width:15px;height:15px;fill:none;stroke:var(--pri);stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}

/* hero-grid keeps site.css's align-items:center so the copy sits against the
   middle of the taller capture card, exactly like the homepage hero.
   The 24px sides are NOT decoration: <header class="wrap hero"> hits two equal
   class selectors, and site.css declares .hero after .wrap, so .hero's shorthand
   zeroes the gutter and the hero runs edge-to-edge on a phone. Restate it. */
.hero{padding:64px 24px 48px}
section[id]{scroll-margin-top:80px}

/* site.css sets section{padding:64px 0}, but .wrap{padding:0 24px} is a class
   selector and outranks a bare element selector, so <section class="wrap">
   renders with ZERO vertical padding and every section collides into the next
   kicker. Restore the rhythm without disturbing the 24px gutter. */
section.wrap{padding-top:58px;padding-bottom:58px}
section.wrap:first-of-type{padding-top:34px}
.sechead{max-width:64ch}
.sechead .h2{margin-top:10px}

/* ── the capture card ─────────────────────────────────────────────────────── */
.getcard{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:26px;box-shadow:var(--shadow-lg)}
.getcard h2{font-family:var(--disp);font-size:21px;margin:0;letter-spacing:-.015em;color:var(--ink)}
.getcard .gsub{font-size:14.5px;color:var(--slate);margin:8px 0 18px;line-height:1.55}
.getcard .btn{width:100%;box-sizing:border-box}
.fld{width:100%;box-sizing:border-box;font-family:var(--body);font-size:15px;padding:13px 14px;
  border:1px solid var(--line);border-radius:12px;background:#fff;color:var(--ink);margin-bottom:10px;transition:.15s}
.fld::placeholder{color:#9AA9B0}
.fld:focus{outline:none;border-color:var(--pri);box-shadow:0 0 0 3px var(--pri-l)}
.fhint{font-size:12px;color:#8A9BA3;margin:-4px 0 12px;line-height:1.5}
.optin{display:flex;gap:9px;align-items:flex-start;font-size:12.5px;color:var(--slate);line-height:1.5;margin:12px 0 14px;cursor:pointer}
.optin input{margin-top:2px;accent-color:var(--pri);flex:none;width:15px;height:15px}
.msg{font-size:13.5px;margin:12px 0 0;color:var(--pri-d);font-weight:600;min-height:18px}
.msg[data-num-state="error"]{color:#B4442F}
.orsep{display:flex;align-items:center;gap:12px;margin:18px 0 14px;color:#93A3AA;font-size:12px;
  letter-spacing:.08em;text-transform:uppercase;font-weight:700}
.orsep::before,.orsep::after{content:"";flex:1;height:1px;background:var(--line)}
.doneic{width:46px;height:46px;border-radius:14px;background:var(--pri-l);display:flex;align-items:center;justify-content:center;margin:0 0 14px}
.doneic svg{width:24px;height:24px;fill:none;stroke:var(--pri-d);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.doneh{font-family:var(--disp);font-size:20px;margin:0;letter-spacing:-.015em;color:var(--ink)}
.qrwhite{margin:16px 0 0;display:flex;justify-content:center}
.qrwhite img{width:120px;height:120px;image-rendering:pixelated;border:1px solid var(--line);border-radius:14px;padding:8px;background:#fff}
.fine{font-size:11.5px;color:#93A3AA;margin:14px 0 0;line-height:1.5}
.fine a{color:#93A3AA;text-decoration:underline}

/* ── what people ask it ───────────────────────────────────────────────────── */
.asks{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:28px}
@media(max-width:880px){.asks{grid-template-columns:1fr}}
.ask{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:20px;box-shadow:var(--shadow)}
.qq{background:var(--pri-l);color:var(--pri-d);border-radius:14px 14px 14px 4px;padding:11px 14px;
  font-size:14.5px;font-weight:700;display:inline-block;line-height:1.45}
.ans{margin:13px 0 0;font-size:14.5px;color:var(--slate);line-height:1.6}

/* ── three steps. NOT .step — site.css owns that name for the wizard. ─────── */
.vsteps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:28px}
@media(max-width:880px){.vsteps{grid-template-columns:1fr}}
.vstep{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:24px;box-shadow:var(--shadow)}
.vnum{width:34px;height:34px;border-radius:10px;background:var(--pri);color:#fff;font-family:var(--disp);
  font-weight:700;display:flex;align-items:center;justify-content:center;font-size:15px;margin-bottom:14px}
.vstep h3{font-family:var(--disp);font-size:18px;margin:0 0 8px;letter-spacing:-.01em}
.vstep p{margin:0;font-size:14.5px;color:var(--slate);line-height:1.6}

/* ── close. Same gradient family as .ctaband in site.css, widened for the QR. ─ */
.vband{background:linear-gradient(120deg,#0E5B52,var(--ink));color:#fff;border-radius:26px;padding:44px 40px;
  display:grid;grid-template-columns:1fr auto;gap:36px;align-items:center}
@media(max-width:780px){.vband{grid-template-columns:1fr;text-align:center;justify-items:center;padding:36px 24px}}
.vband h2{color:#fff;margin:0}
.vband p{color:#bcd8cf;margin:12px 0 22px;font-size:16px;line-height:1.55;max-width:46ch}
@media(max-width:780px){.vband p{margin-inline:auto}}
.bandbtns{display:flex;gap:12px;flex-wrap:wrap}
@media(max-width:780px){.bandbtns{justify-content:center}}
.qrbox{background:#fff;padding:12px;border-radius:16px;line-height:0}
.qrbox img{width:136px;height:136px;image-rendering:pixelated;display:block}
.qrcap{color:#9FBDBA;font-size:12px;text-align:center;margin-top:10px;letter-spacing:.04em}
</style>

<script src="/num-capture.js" data-page="landing" defer></script>
<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://itsnum.com/#organization","name":"NUM","alternateName":"NUM travel concierge","url":"https://itsnum.com/","email":"info@5arz.com","description":"NUM is an AI travel concierge you chat with. It plans your trip in any language and books real, verified local places across 77 destinations in 38 countries.","parentOrganization":{"@type":"Organization","name":"5arz","url":"https://5arz.com/","description":"5arz is the proof-of-human company. It verifies that a real, unique, live person is behind an account or an action."},"sameAs":["https://5arz.com/"],"contactPoint":[{"@type":"ContactPoint","email":"info@5arz.com","contactType":"customer support","availableLanguage":["en"]}]},{"@type":"WebSite","@id":"https://itsnum.com/#website","url":"https://itsnum.com/","name":"NUM","publisher":{"@id":"https://itsnum.com/#organization"},"inLanguage":"en"},{"@type":"WebPage","@id":"https://itsnum.com/vip/#webpage","url":"https://itsnum.com/vip/","name":"Num — your VIP travel concierge","description":"Num is a travel concierge you message. It plans your day, books the table and answers in your language, in 77 destinations across 38 countries.","isPartOf":{"@id":"https://itsnum.com/#website"},"about":{"@id":"https://itsnum.com/#organization"},"inLanguage":"en","datePublished":"2026-07-31","dateModified":"2026-07-31"}]}</script>
</head>
<body>


<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Get the NUM app — your travel concierge on your home screen</title>
<meta name="description" content="Install NUM in two taps. One thread for the whole trip: real verified places, bookings, a calendar that catches clashes, and plans you build with friends. iPhone and Android.">
<link rel="canonical" href="https://itsnum.com/app/">
<meta name="theme-color" content="#F6FAF9">
<meta property="og:title" content="Get the NUM app">
<meta property="og:description" content="Your AI travel concierge, on your home screen. Live in 38 countries.">
<meta property="og:url" content="https://itsnum.com/app/">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/site.css">
<style>
.appnav{position:sticky;top:0;z-index:60;background:rgba(246,250,249,.86);backdrop-filter:saturate(180%) blur(12px);border-bottom:1px solid var(--line)}
.appnav .row{display:flex;align-items:center;justify-content:space-between;height:66px;gap:16px}
.appnav a.brand{text-decoration:none;color:var(--ink)}
.hero-app{padding-top:56px;padding-bottom:18px}
.hero-app .grid2{display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center}
.hero-app .sub{font-size:19px;color:var(--slate);margin-top:18px;max-width:40ch}
.trust svg{width:15px;height:15px;stroke:var(--pri);fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;flex:none}
.qr-card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);padding:22px;display:flex;gap:18px;align-items:center}
.qr-card img{width:118px;height:118px;border-radius:12px;display:block;flex:none}
.qr-card .t{font-family:var(--disp);font-weight:700;font-size:17px}
.qr-card p{font-size:13.5px;color:var(--slate);margin:6px 0 0}
.linkchip{display:inline-flex;align-items:center;gap:8px;margin-top:12px;background:var(--pri-xl);border:1px solid var(--line);color:var(--pri-d);font-weight:700;font-size:13.5px;padding:8px 14px;border-radius:999px;font-family:var(--body)}
.tabs{display:inline-flex;gap:6px;background:var(--pri-xl);border:1px solid var(--line);border-radius:999px;padding:5px;margin-bottom:22px}
.tab{border:0;background:transparent;cursor:pointer;font-family:var(--body);font-weight:700;font-size:14px;color:var(--slate);padding:9px 22px;border-radius:999px;transition:background .16s ease,color .16s ease,box-shadow .16s ease}
.tab[aria-selected="true"]{background:var(--pri);color:#fff;box-shadow:0 6px 16px rgba(14,164,131,.28)}
.steps[hidden]{display:none}
.steps ol{list-style:none;counter-reset:s;margin:0;padding:0;display:grid;gap:14px;max-width:52ch}
.steps li{counter-increment:s;display:flex;gap:14px;align-items:flex-start;font-size:15.5px;color:var(--ink2)}.steps li>span{min-width:0;overflow-wrap:break-word}
.steps li::before{content:counter(s);flex:none;width:28px;height:28px;border-radius:50%;background:var(--pri-l);color:var(--pri-d);font-family:var(--disp);font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center}
.feat{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.feat .ic svg{width:22px;height:22px;stroke:var(--pri-d);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.feat .ic.amber svg{stroke:#B07A22}
.shareband{background:linear-gradient(120deg,#0E5B52,var(--ink));color:#fff;border-radius:26px;padding:44px 40px}
.shareband .in{display:flex;gap:36px;align-items:center;justify-content:space-between;flex-wrap:wrap}
.shareband h2{color:#fff;margin:0}
.shareband p{color:#a7c3bc;font-size:15px;margin:12px 0 0;max-width:46ch}
.shareband .qr{background:#fff;padding:12px;border-radius:18px;flex:none}
.shareband .qr img{width:132px;height:132px;display:block}
.shareband .acts{margin-top:22px;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.urlchip{display:inline-flex;align-items:center;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.22);color:#fff;font-weight:700;font-size:14.5px;padding:12px 18px;border-radius:12px;font-family:var(--body)}
.foot{border-top:1px solid var(--line);margin-top:60px;padding-top:26px;padding-bottom:40px;font-size:13.5px;color:var(--slate);display:flex;gap:18px;flex-wrap:wrap;justify-content:space-between;align-items:center}
.foot a{color:var(--slate);text-decoration:none}
.foot a:hover{color:var(--pri-d)}
.foot .set{display:flex;gap:20px;flex-wrap:wrap}
@media(max-width:860px){.hero-app .grid2{grid-template-columns:1fr;gap:28px}.feat{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.h1{font-size:38px}.h2{font-size:27px}.feat{grid-template-columns:1fr}.shareband{padding:30px 22px}.hero-app{padding-top:36px;padding-bottom:12px}.appnav .row{gap:10px}.appnav .btn.ghost{font-size:13px;padding:10px 14px}}
</style>
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<meta property="og:image" content="https://itsnum.com/assets/og.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:image" content="https://itsnum.com/assets/og.jpg">
<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://itsnum.com/#organization","name":"NUM","alternateName":"NUM travel concierge","url":"https://itsnum.com/","email":"info@5arz.com","description":"NUM is an AI travel concierge you chat with. It plans your trip in any language and books real, verified local places across 77 destinations in 38 countries.","parentOrganization":{"@type":"Organization","name":"5arz","url":"https://5arz.com/","description":"5arz is the proof-of-human company. It verifies that a real, unique, live person is behind an account or an action."},"sameAs":["https://5arz.com/"],"contactPoint":[{"@type":"ContactPoint","email":"info@5arz.com","contactType":"customer support","availableLanguage":["en"]}]},{"@type":"WebSite","@id":"https://itsnum.com/#website","url":"https://itsnum.com/","name":"NUM","publisher":{"@id":"https://itsnum.com/#organization"},"inLanguage":"en"},{"@type":"WebPage","@id":"https://itsnum.com/app/#webpage","url":"https://itsnum.com/app/","name":"Get the NUM app — your travel concierge on your home screen","description":"Install NUM in two taps. One thread for the whole trip: real verified places, bookings, a calendar that catches clashes, and plans you build with friends. iPhone and Android.","isPartOf":{"@id":"https://itsnum.com/#website"},"about":{"@id":"https://itsnum.com/#organization"},"inLanguage":"en","datePublished":"2026-07-31","dateModified":"2026-07-31","breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://itsnum.com/"},{"@type":"ListItem","position":2,"name":"Get the app","item":"https://itsnum.com/app/"}]}},{"@type":"SoftwareApplication","@id":"https://itsnum.com/app#app","name":"NUM","alternateName":"NUM travel concierge","applicationCategory":"TravelApplication","operatingSystem":"iOS, Android, Web","url":"https://itsnum.com/app/","installUrl":"https://itsnum.com/get/","publisher":{"@id":"https://itsnum.com/#organization"},"description":"An AI travel concierge that plans your trip in chat and books real, verified local places in 77 destinations across 38 countries, in any language.","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"featureList":["Plans a trip in conversation, in any language","Books verified local restaurants, hotels, spas, tours and clinics","Works on LINE, or installs to a phone home screen","Available 24 hours"]}]}</script>
</head>
<body>

<nav class="appnav"><div class="wrap row">
  <a class="brand" href="/"><span class="dot"></span>NUM <small>travel concierge</small></a>
  <a class="btn ghost" href="https://line.me/R/ti/p/@799pyrus">Message Num on LINE</a>
</div></nav>

<header class="wrap hero-app">
  <div class="grid2">
    <div>
      <span class="pill">✦ Live in 38 countries</span>
      <h1 class="h1" style="margin-top:18px">Put Num on your home&nbsp;screen.</h1>
      <p class="sub">Your concierge for the whole trip — planning, booking and the small stuff — in one thread. It installs straight from the browser in two taps.</p>
      <div style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn pri lg" id="open" href="https://app.itsnum.com/?app">Open Num</a>
        <script>
        // Carry the referral through to the app. Without this the whole chain
        // works and then loses attribution at the final hop: a shared link
        // reaches /get, /get forwards the query string here, and this button
        // then sent people to a bare /?app — so whoever did the inviting was
        // credited with nothing.
        (function () {
          var ref = new URLSearchParams(location.search).get('ref');
          if (!ref) return;
          var a = document.getElementById('open');
          if (a) a.href = 'https://app.itsnum.com/r/' + encodeURIComponent(ref);
        })();
        </script>
        <button class="btn ghost lg" type="button" data-share>Share this link</button>
      </div>
      <div class="trust" style="margin-top:24px">
        <span><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg> No app store, no download</span>
        <span><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg> iPhone and Android</span>
        <span><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg> Free to install</span>
      </div>
    </div>
    <div class="qr-card">
      <img src="/app/qr-get.png" alt="QR code for itsnum.com/get" width="118" height="118">
      <div>
        <div class="t">Scan to install</div>
        <p>Point a camera at the code. It opens this page on the phone, ready to add.</p>
        <span class="linkchip">itsnum.com/get</span>
      </div>
    </div>
  </div>
</header>

<section class="wrap" style="padding-top:44px;padding-bottom:0">
  <div class="card" style="padding:34px">
    <span class="kicker">Install</span>
    <h2 class="h2" style="margin-top:10px">Two taps and it is on your home screen.</h2>
    <p class="lead" style="margin-bottom:26px">It behaves like any other app — its own icon, full screen, and it opens straight to your trip.</p>
    <div class="tabs" role="tablist" aria-label="Choose your phone">
      <button class="tab" id="t-ios" type="button" role="tab" aria-selected="true" aria-controls="s-ios">iPhone</button>
      <button class="tab" id="t-android" type="button" role="tab" aria-selected="false" aria-controls="s-android">Android</button>
    </div>
    <div class="steps" id="s-ios" role="tabpanel" aria-labelledby="t-ios"><ol>
      <li><span>Open <b>itsnum.com/get</b> in <b>Safari</b>.</span></li>
      <li><span>Tap <b>Share</b> in the toolbar.</span></li>
      <li><span>Choose <b>Add to Home Screen</b>.</span></li>
      <li><span>Tap <b>Add</b>. Num is on your home screen.</span></li>
    </ol></div>
    <div class="steps" id="s-android" role="tabpanel" aria-labelledby="t-android" hidden><ol>
      <li><span>Open <b>itsnum.com/get</b> in <b>Chrome</b>.</span></li>
      <li><span>Tap the <b>menu</b>, top right.</span></li>
      <li><span>Choose <b>Install app</b> or <b>Add to Home screen</b>.</span></li>
      <li><span>Confirm. Num is on your home screen.</span></li>
    </ol></div>
    <p style="margin-top:24px;font-size:14px;color:var(--slate);border-top:1px solid var(--line);padding-top:18px">This is a real install, not a bookmark. Num keeps your trip, your plans and your thread between visits.</p>
  </div>
</section>

<section class="wrap">
  <span class="kicker">What you get</span>
  <h2 class="h2" style="margin-top:10px">Everything the app does.</h2>
  <p class="lead" style="margin-bottom:28px">One concierge, one thread, the whole trip.</p>
  <div class="feat">

    <div class="card hov">
      <div class="ic"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.2-.6L3 21l1.8-4.6A8.4 8.4 0 0 1 12 3.1a8.4 8.4 0 0 1 9 8.4Z"/></svg></div>
      <h3>One thread for the whole trip</h3>
      <p>Ask in plain language, any language. Everything you plan and book stays in the same conversation.</p>
    </div>

    <div class="card hov">
      <div class="ic"><svg viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><path d="m8.8 10.2 2.2 2.2 4.2-4.2"/></svg></div>
      <h3>Real places, verified</h3>
      <p>More than half a million of them across 77 destinations, with distance, hours and whether they are open right now.</p>
    </div>

    <div class="card hov">
      <div class="ic"><svg viewBox="0 0 24 24"><path d="M19 21 12 16.7 5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2Z"/><path d="m9.2 9.4 2 2 3.6-3.6"/></svg></div>
      <h3>Bookings without the back and forth</h3>
      <p>Tables, cars, spas, tours. Num holds the slot, confirms it, and puts the details in your thread.</p>
    </div>

    <div class="card hov">
      <div class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="m9.4 15.2 1.7 1.7 3.5-3.5"/></svg></div>
      <h3>A calendar that catches clashes</h3>
      <p>Every reservation lands in one place, days or weeks ahead. It flags double bookings and holds about to expire.</p>
    </div>

    <div class="card hov">
      <div class="ic"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M2.8 20a6.2 6.2 0 0 1 12.4 0"/><path d="M16.4 5.4a3.2 3.2 0 0 1 0 5.9M18 14.5a6.2 6.2 0 0 1 3.2 5.5"/></svg></div>
      <h3>Plans you build with friends</h3>
      <p>Share a plan, everyone sees the same itinerary, and changes show up for the whole group at once.</p>
    </div>

    <div class="card hov">
      <div class="ic"><svg viewBox="0 0 24 24"><path d="M21.5 3 10.4 14.1M21.5 3l-7.2 18-4-7.8L2.5 9.2Z"/></svg></div>
      <h3>Invite anyone by text</h3>
      <p>Send a link and they join the plan from their phone. Nothing to install on their side.</p>
    </div>

    <div class="card hov">
      <div class="ic"><svg viewBox="0 0 24 24"><path d="M12 3.2 13.9 9l5.9 2-5.9 2-1.9 5.8L10.1 13 4.2 11 10.1 9Z"/><path d="M18.6 3.4v3.2M20.2 5h-3.2"/></svg></div>
      <h3>It remembers what you like</h3>
      <p>Quiet tables, the food you avoid, how far you will walk. You say it once and it holds for the rest of the trip.</p>
    </div>

    <div class="card hov">
      <div class="ic"><svg viewBox="0 0 24 24"><path d="M9 4.5 3.5 6.7v12.8L9 17.3l6 2.2 5.5-2.2V4.5L15 6.7Z"/><path d="M9 4.5v12.8M15 6.7v12.8"/></svg></div>
      <h3>A map of what is around you</h3>
      <p>Everything verified nearby, on one map, so you can see the neighbourhood before you commit to it.</p>
    </div>

    <div class="card hov">
      <div class="ic amber"><svg viewBox="0 0 24 24"><rect x="3" y="7.5" width="18" height="12.5" rx="3"/><path d="M3 8.4V7a2.5 2.5 0 0 1 2.5-2.5H17"/><path d="M20.5 12.9h-3.6a1.9 1.9 0 0 0 0 3.7h3.6"/></svg></div>
      <h3>Pay and split in the app</h3>
      <p>Keep a tab open for the trip, settle it in the app, and split it with whoever came along.</p>
    </div>

    <div class="card hov">
      <div class="ic amber"><svg viewBox="0 0 24 24"><path d="m12 3.6 2.6 5.3 5.9.9-4.3 4.1 1 5.9L12 17.1l-5.2 2.7 1-5.9-4.3-4.1 5.9-.9Z"/></svg></div>
      <h3>Stars on what you spend</h3>
      <p>Every booking earns stars. Spend them on the next one, anywhere Num is live.</p>
    </div>

    <div class="card hov">
      <div class="ic amber"><svg viewBox="0 0 24 24"><path d="M4.6 8h14.8l-1.1 11.2a2 2 0 0 1-2 1.8H7.7a2 2 0 0 1-2-1.8Z"/><path d="M9 8V6.2a3 3 0 0 1 6 0V8"/></svg></div>
      <h3>Errands, handled</h3>
      <p>Someone to collect it, deliver it or queue for it while you carry on with the day.</p>
    </div>

    <div class="card hov">
      <div class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.8"/><path d="M3.4 12h17.2"/><path d="M12 3.2c2.2 2.4 3.4 5.5 3.4 8.8s-1.2 6.4-3.4 8.8c-2.2-2.4-3.4-5.5-3.4-8.8S9.8 5.6 12 3.2Z"/></svg></div>
      <h3>Any language, any hour</h3>
      <p>Sixteen languages, answered in seconds, whatever time it is where you landed.</p>
    </div>

  </div>
</section>

<section class="wrap">
  <div class="shareband">
    <div class="in">
      <div>
        <span class="kicker" style="color:#79e6c8">Share it</span>
        <h2 class="h2" style="margin-top:10px">One link. Anyone, any phone.</h2>
        <p>Send someone <b>itsnum.com/get</b> and they are set up in seconds, on iPhone or Android. The same link works on a card, a poster or a group chat.</p>
        <div class="acts">
          <button class="btn pri lg" type="button" data-share>Share this link</button>
          <span class="urlchip">itsnum.com/get</span>
        </div>
      </div>
      <div class="qr"><img src="/app/qr-get.png" alt="QR code for itsnum.com/get" width="132" height="132"></div>
    </div>
  </div>
</section>

<footer class="wrap foot">
  <span>&copy; 2026 NUM by 5arz</span>
  <span class="set"><a href="/">itsnum.com</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/business/">List your business</a></span>
</footer>

<script>
(function () {
  var q = location.search;
  if (q && q.length > 1) { var a = document.getElementById('open'); a.href = a.href + '&' + q.slice(1); }
  function pick(which) {
    ['ios', 'android'].forEach(function (k) {
      document.getElementById('t-' + k).setAttribute('aria-selected', String(k === which));
      document.getElementById('s-' + k).hidden = k !== which;
    });
  }
  if (!/iPhone|iPad|iPod/.test(navigator.userAgent)) pick('android');
  document.getElementById('t-ios').onclick = function () { pick('ios'); };
  document.getElementById('t-android').onclick = function () { pick('android'); };
})();
(function () {
  var U = 'https://itsnum.com/get';
  var nodes = document.querySelectorAll('[data-share]');
  for (var i = 0; i < nodes.length; i++) {
    (function (b) {
      b.addEventListener('click', function () {
        var t = b.textContent;
        function flash(m) { b.textContent = m; setTimeout(function () { b.textContent = t; }, 1800); }
        if (navigator.share) {
          navigator.share({
            title: 'Num - your travel concierge',
            text: 'Num plans your trip and books real, verified places. Install it here:',
            url: U
          }).catch(function () {});
          return;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(U).then(function () { flash('Link copied'); }, function () { flash(U); });
          return;
        }
        flash(U);
      });
    })(nodes[i]);
  }
})();
</script>

</body>
</html>

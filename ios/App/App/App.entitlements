<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Guideline 4.8 (Login Services). App Review rejected 1.0(2) because the
	     app offered "Continue with Google" and no equivalent privacy-preserving
	     login. Sign in with Apple is that equivalent.

	     This entitlement only signs if the capability is ALSO enabled on the
	     App ID (developer.apple.com → Identifiers → com.itsnum.app → Sign in
	     with Apple) and the provisioning profile has been regenerated. If the
	     archive fails with "Provisioning profile doesn't include the
	     com.apple.developer.applesignin entitlement", that portal step is the
	     missing one — not this file. -->
	<!-- Universal links: a Num link (/c/, /i/, /r/ on app.itsnum.com) opens
	     this app instead of Safari, so scanning a friend's QR adds them in
	     the account that actually holds your friends. Needs the Associated
	     Domains capability ticked on the App ID and the profile regenerated,
	     the same portal step as Sign in with Apple above. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.itsnum.com</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>

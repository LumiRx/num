# ── secrets: NEVER commit. Keys live as local dotfiles only. ──
.resend_key
.line_secret
.line_token
.places_key
*.key
.env
.env.*
.dev.vars
# ── junk / heavy ──
node_modules/
.wrangler/
.DS_Store
*.log
# FUSE leftovers. When a file is replaced while something still holds it open,
# the mount renames the old inode to .fuse_hidden<hex> instead of unlinking it.
# An agent session doing mutation testing (cp/sed a source file, run tests,
# restore) generates these by the handful — six of them, ~9,000 lines of stale
# duplicated source, landed in a commit on 2026-08-04. Harmless to run, but
# they poison every future grep and code review in the repo.
.fuse_hidden*
# ── build output ──
dist/
*.tsbuildinfo
out/
.scout_key
.claim_admin_key
.release-staged.json

# ── deploy snapshots: local rollback copies, not source ──
.deploy-backups/

# ai/release.sh state
ai/.staged-version
ai/.previous-version

# Python bytecode. A .pyc landed in a commit once (leads/__pycache__) and
# scripts/build.py regenerates a directory of them on every run, so every
# session that builds pages starts with a dirty tree it did not dirty.
__pycache__/
*.pyc

# Vite writes vite.config.ts.timestamp-*.mjs while resolving the config and
# does not always clean up after itself. Four of them were sitting in the tree.
vite.config.ts.timestamp-*.mjs

# Generated ingest SQL. 121 MB of per-destination INSERT files, regenerated by
# scripts/ingest_*.mjs whenever a destination is re-walked. The database is the
# record; these are the transport.
sql/

# Staged-for-deletion dist snapshots (_stale-dist-<timestamp>/). Rollback
# copies somebody parked in the tree, not source.
_stale-dist-*/
affiliates.json

# Local edit/deploy claims — see scripts/claim.mjs. One machine's worktree, never shared.
.claims/
.secrets/

# Local pre-edit backups. Never committed.
_to_delete/

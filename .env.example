# NUM — environment reference (mirrors apps/api/settings.py)
# Copy to .env for local dev; on Railway set these as service variables.
# ✳ = required to boot · ▲ = required for pilot · rest optional/phase-2

# --- App ---
APP_ENV=development                       # production on Railway
APP_BASE_URL=http://localhost:8000        # ▲ your Railway URL once deployed
LOG_LEVEL=INFO

# --- LLM ---
ANTHROPIC_API_KEY=                        # ✳ console.anthropic.com
CLAUDE_MODEL_CHAT=claude-sonnet-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# --- Embeddings (persistent memory; skip = concierge runs memory-less) ---
OPENAI_API_KEY=                           # ▲ platform.openai.com
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Twilio (SMS + WhatsApp) ---
TWILIO_ACCOUNT_SID=                       # ▲ console.twilio.com
TWILIO_AUTH_TOKEN=                        # ▲
TWILIO_PHONE_NUMBER=                      # ▲ E.164, e.g. +18885551234
TWILIO_WHATSAPP_FROM=                     # ▲ whatsapp:+18885551234 (sandbox no. until sender approved)

# --- LINE ---
LINE_CHANNEL_ID=                          # ▲ developers.line.biz
LINE_CHANNEL_SECRET=                      # ▲
LINE_CHANNEL_ACCESS_TOKEN=                # ▲ long-lived, Messaging API tab

# --- WeChat Service Account (blocked on SA decision — leave blank until then) ---
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=                             # the webhook-config token YOU choose in the WeChat console
WECHAT_AES_KEY=                           # reserved (encrypted mode, phase 2)

# --- Supabase ---
SUPABASE_URL=                             # ✳ https://txabrxbobyxznkgarpkc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                # ✳ Dashboard → Settings → API (server-only; NEVER client-side)
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=

# --- Encryption (phase 2 — save_secure_pii) ---
KMS_PROVIDER=supabase_vault
KMS_KEY_ID=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Workers ---
REDIS_URL=redis://localhost:6379/0        # unused until a queue worker lands

# --- Observability ---
SENTRY_DSN=                               # ▲ sentry.io project DSN

# --- Ops alerts ---
SLACK_OPS_WEBHOOK_URL=                    # ▲ Slack incoming webhook for #num-ops (whale leads + escalations)

# --- Multi-tenancy ---
DEFAULT_PARTNER_TENANT_ID=                # ▲ uuid of the Phuket partner row in partner_tenants

{
  // NUM consumer app — SPA (dist/) + AI API (/api/num) in one Worker.
  // NOTE: the root wrangler.jsonc is the separate partner console Worker
  // ("num-console") — deploy this file with `wrangler deploy --config wrangler.app.jsonc`.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "num-app",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-07-01",
  // @anthropic-ai/sdk's credential-chain modules import node:fs / node:path.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    // Unmatched paths fall back to index.html so client-side routing works.
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; everything else is served as a static asset.
    // /api/* is the app's own API; /e/* is the public RSVP page, which must be
    // server-rendered rather than falling through to the SPA shell.
    "run_worker_first": ["/api/*", "/e/*", "/claim/confirm"]
  },
  // Same brain as the texts: the num-ai LINE concierge's database (67 live
  // destinations, 500k+ ranked places). The app only reads; num-ai owns writes.
  "d1_databases": [
    { "binding": "DB", "database_name": "num-db", "database_id": "823979c8-b118-4a8a-953a-e07655205cf5" },
    // Read-only in practice: the app reads verification (verified_at, UHA,
    // verified_sessions) to build the trust envelope it hands AiR. The payout
    // desk owns every write to this database.
    { "binding": "LEDGER", "database_name": "5arz-ledger", "database_id": "479dfff2-cd26-49b0-ae54-84d4a41b99aa" }
  ],
  // Workers AI — the small lane (worker/router.mjs) answers chit-chat with a
  // fast open model instead of spending a Claude call.
  "ai": { "binding": "AI" },
  // Per-IP rate limit for /api/num. Counters live in Cloudflare's infra, so
  // they survive isolate churn — the in-worker Map alone does not (see
  // worker/guard.mjs). namespace_id is a per-Worker identifier, not a secret.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  // Instant preview URL (num-app.<account>.workers.dev) — live immediately after deploy
  // Push services require a contact address for abuse reports. Not a secret —
  // it is sent in the clear on every push — so it lives here where it can be
  // changed without a secret rotation.
  "vars": { "VAPID_SUBJECT": "mailto:hello@itsnum.com" },
  // The concierge model. Opus is the default in code; set it here to flip the
  // latency/cost trade without a code change (e.g. "claude-sonnet-5").
  // "vars": { "NUM_MODEL": "claude-sonnet-5" },
  // Branded home for the app. Share links point at itsnum.com/get, which lands
  // here. A workers.dev URL in something we ask a stranger to tap is a trust leak.
  "routes": [
    { "pattern": "app.itsnum.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}

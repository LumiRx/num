{
  // NUM consumer app — SPA (dist/) + AI API (/api/num) in one Worker.
  // NOTE: the root wrangler.jsonc is the separate partner console Worker
  // ("num-console") — deploy this file with `wrangler deploy --config wrangler.app.jsonc`.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "num-app",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-07-01",
  // @anthropic-ai/sdk's credential-chain modules import node:fs / node:path.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    // Unmatched paths fall back to index.html so client-side routing works.
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; everything else is served as a static asset.
    // /api/* is the app's own API; /e/* is the public RSVP page, which must be
    // server-rendered rather than falling through to the SPA shell.
    // /r/*, /i/* and /c/* are the short share links. They must reach the Worker,
    // not the SPA fallback, or the asset handler answers 200 with the app shell
    // and the redirect never happens.
    "run_worker_first": ["/api/*", "/e/*", "/claim/confirm", "/r/*", "/i/*", "/c/*", "/go/*"]
  },
  // Same brain as the texts: the num-ai LINE concierge's database (67 live
  // destinations, 500k+ ranked places). The app only reads; num-ai owns writes.
  "d1_databases": [
    { "binding": "DB", "database_name": "num-db", "database_id": "823979c8-b118-4a8a-953a-e07655205cf5" },
    // Read-only in practice: the app reads verification (verified_at, UHA,
    // verified_sessions) to build the trust envelope it hands AiR. The payout
    // desk owns every write to this database.
    { "binding": "LEDGER", "database_name": "5arz-ledger", "database_id": "479dfff2-cd26-49b0-ae54-84d4a41b99aa" }
  ],
  // Workers AI — the small lane (worker/router.mjs) answers chit-chat with a
  // fast open model instead of spending a Claude call.
  "ai": { "binding": "AI" },
  // Per-IP rate limit for /api/num. Counters live in Cloudflare's infra, so
  // they survive isolate churn — the in-worker Map alone does not (see
  // worker/guard.mjs). namespace_id is a per-Worker identifier, not a secret.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  // Instant preview URL (num-app.<account>.workers.dev) — live immediately after deploy
  // Push services require a contact address for abuse reports. Not a secret —
  // it is sent in the clear on every push — so it lives here where it can be
  // changed without a secret rotation.
  // SABRE_PCC is the Point of Sale (Pseudo City Code) every shopping call is
  // made under. It is NOT a secret — it identifies the agency office, not a
  // credential — so it lives here rather than in wrangler secret.
  //
  // It matters more than its size suggests: without an explicit PCC, Sabre
  // derives one from the credential's group, and a group that is not a valid
  // 3-4 character code (DEVCENTER, for instance) produces an EMPTY offers
  // array rather than an error. Silent emptiness that looks exactly like "no
  // flights available" cost this integration an afternoon.
  //
  // FF9A is the certification example from Sabre's own docs and returns real
  // cert content. REPLACE IT with the agency's own PCC before production.
  // ADMIN_EMAIL is an identity, not a credential — ADMIN_KEY is still the gate.
  // It stamps the signed session so the console can say who is looking, and so
  // the sign-in log has a name in it rather than a row of anonymous successes.
  "vars": { "VAPID_SUBJECT": "mailto:hello@itsnum.com", "SABRE_PCC": "FF9A", "ADMIN_EMAIL": "andre@thatislumi.com" },
  // The concierge model. Opus is the default in code; set it here to flip the
  // latency/cost trade without a code change (e.g. "claude-sonnet-5").
  // "vars": { "NUM_MODEL": "claude-sonnet-5" },
  // Branded home for the app. Share links point at itsnum.com/get, which lands
  // here. A workers.dev URL in something we ask a stranger to tap is a trust leak.
  // Transactional email. The binding needs no API key, but the sending domain
  // must be onboarded first:  npx wrangler email sending enable itsnum.com
  "send_email": [{ "name": "EMAIL" }],
  "routes": [
    { "pattern": "app.itsnum.com", "custom_domain": true }
  ],
  "workers_dev": true,
  // Num watching Num, every 5 minutes. The checks are in worker/health.mjs and
  // are deliberately aimed at the failures that return 200 — a read-only
  // database, a dead brain key, a pay rail that can charge but never deliver.
  // Alerts fire only on a CHANGE of state, so this can run forever without
  // becoming noise everyone learns to ignore.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}

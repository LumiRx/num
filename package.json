{
  "name": "num-concierge",
  "private": true,
  "version": "0.8.254",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "eslint worker scripts server growth && node scripts/travelspeak-lint.mjs && node --test worker/*.test.mjs src/lib/*.test.mjs scripts/*.test.mjs scripts/pseo/*.test.mjs growth/*.test.mjs agents/roster/*.test.mjs",
    "lint:travel": "node scripts/travelspeak-lint.mjs",
    "uptime": "node scripts/uptime.mjs",
    "preview": "vite preview",
    "ai": "node server/index.mjs",
    "design:check": "node scripts/design-check.mjs status",
    "release": "node scripts/release.mjs",
    "release:stage": "node scripts/release.mjs stage",
    "release:ship": "node scripts/release.mjs ship",
    "release:rollback": "node scripts/release.mjs rollback",
    "test:availability": "node worker/availability.test.mjs",
    "test:invites": "node scripts/test-invites.mjs",
    "lint": "eslint worker scripts server growth",
    "app:sync": "npm run build && npx cap sync",
    "app:ios": "npm run app:sync && npx cap open ios",
    "app:android": "npm run app:sync && npx cap open android",
    "claim": "node scripts/claim.mjs",
    "mcp:integrity": "node scripts/mcp-integrity.mjs",
    "mcp:integrity:offline": "node scripts/mcp-integrity.mjs --offline"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}

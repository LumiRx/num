{
  "name": "num-concierge",
  "private": true,
  "version": "0.8.402",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "eslint worker scripts server growth && node scripts/travelspeak-lint.mjs && node scripts/coverage-claims.mjs && node scripts/head-price-lint.mjs && node scripts/voice-lint.mjs && node --test worker/*.test.mjs src/lib/*.test.mjs ai/*.test.mjs scripts/*.test.mjs scripts/pseo/*.test.mjs growth/*.test.mjs growth/pos/*.test.mjs agents/*.test.mjs agents/roster/*.test.mjs",
    "lint:travel": "node scripts/travelspeak-lint.mjs",
    "lint:heads": "node scripts/head-price-lint.mjs",
    "uptime": "node scripts/uptime.mjs",
    "preview": "vite preview",
    "ai": "node server/index.mjs",
    "design:check": "node scripts/design-check.mjs status",
    "check:site": "node scripts/coverage-claims.mjs && node scripts/head-price-lint.mjs && node scripts/travelspeak-lint.mjs",
    "deploy:site": "npm run check:site && npx wrangler deploy --config wrangler.jsonc && node scripts/deploydrift.mjs record num-console",
    "deploy:growth": "npx wrangler deploy --config growth/wrangler.jsonc && node scripts/deploydrift.mjs record num-growth",
    "release": "node scripts/release.mjs",
    "review:ipad": "node scripts/ipad-review-walkthrough.mjs",
    "release:stage": "node scripts/release.mjs stage",
    "release:ship": "node scripts/release.mjs ship",
    "release:rollback": "node scripts/release.mjs rollback",
    "ship": "node scripts/release.mjs stage",
    "ship:live": "node scripts/release.mjs ship",
    "ship:back": "node scripts/release.mjs rollback",
    "db:pending": "node scripts/apply-host-migrations.mjs --dry",
    "db:apply": "node scripts/apply-host-migrations.mjs",
    "test:availability": "node worker/availability.test.mjs",
    "test:invites": "node scripts/test-invites.mjs",
    "lint": "eslint worker scripts server growth",
    "app:sync": "npm run build && npx cap sync",
    "app:ios": "npm run store:check && npx cap open ios",
    "store:audit": "node scripts/ios-store-audit.mjs",
    "store:smoke": "node scripts/ios-launch-smoke.mjs",
    "store:check": "node scripts/ios-store-check.mjs",
    "app:ship": "node scripts/ios-ship.mjs",
    "app:android": "npm run app:sync && npx cap open android",
    "claim": "node scripts/claim.mjs",
    "mcp:integrity": "node scripts/mcp-integrity.mjs",
    "mcp:integrity:offline": "node scripts/mcp-integrity.mjs --offline",
    "deploy:ai": "npx wrangler deploy --config ai/wrangler.jsonc && node scripts/deploydrift.mjs record num-ai",
    "deploy:check": "node scripts/deploydrift.mjs",
    "deploy:mark": "node scripts/deploydrift.mjs record",
    "deploy:files": "node scripts/deploydrift.mjs files",
    "ledger": "node scripts/ledger.mjs",
    "ledger:add": "node scripts/ledger.mjs add",
    "ledger:check": "node scripts/ledger.mjs check",
    "daily": "node scripts/ledger.mjs check && node scripts/deploydrift.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "playwright": "^1.55.0",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}

{
  "name": "Num — Your Concierge",
  "short_name": "Num",
  "description": "One thread, one calendar, zero forms.",
  "start_url": "/?app",
  "scope": "/",
  "id": "/?app",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "categories": ["travel", "lifestyle", "productivity"],
  "background_color": "#f3f2f2",
  "theme_color": "#faf7f4",
  "launch_handler": { "client_mode": "focus-existing" },
  "shortcuts": [
    {
      "name": "Ask Num",
      "short_name": "Ask",
      "description": "Open the thread and ask for anything",
      "url": "/?app&go=thread"
    },
    {
      "name": "New plan",
      "short_name": "Plan",
      "description": "Start a plan and invite friends",
      "url": "/?app&go=plan"
    },
    {
      "name": "Wallet",
      "short_name": "Wallet",
      "description": "Stars, tabs and receipts",
      "url": "/?app&go=wallet"
    }
  ],
  "share_target": {
    "action": "/?app",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}

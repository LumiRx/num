{
  // NUM partner demo console — assets-only Worker
  // Deploys public/ as static assets; /console/ serves the demo.
  "name": "num-console",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    // Without this, an unmatched path falls back to the asset server default and
    // the zone gets an infinite soft-404 space: every nonexistent URL answering
    // 200 with a page. "404-page" serves public/404.html with a real 404 status,
    // which is what stops Google indexing junk.
    "not_found_handling": "404-page"
  },
  // Off. This was on while num-console was a side project and the workers.dev URL
  // was the only way to see it. Now that it serves the whole marketing site, that
  // hostname would publish a second, fully crawlable copy of every page under a
  // name we do not put in public. Verify on itsnum.com instead — it is the thing
  // being verified.
  "workers_dev": false,
  // num-console is now the origin for the WHOLE zone. The older Cloudflare Pages
  // project ("itsnum") used to serve every unrouted path and answered 200 with its
  // homepage for URLs that do not exist — an unbounded soft-404 space, and the last
  // place on the internet still saying "by Lumi". The catch-all below takes it out
  // of the request path entirely.
  //
  // Safe alongside the API workers because Cloudflare picks the MOST SPECIFIC
  // matching route: itsnum.com/api/claims* (num-growth) beats itsnum.com/api/claim*
  // (num-ai) beats itsnum.com/* (here). Do not delete the explicit routes below —
  // they cost nothing and they document what this worker is expected to own.
  "routes": [
    { "pattern": "itsnum.com/*",        "zone_name": "itsnum.com" },
    // www serves the same assets rather than the old Pages site. Every page
    // canonicalises to the apex, so this consolidates rather than duplicates.
    { "pattern": "www.itsnum.com/*",    "zone_name": "itsnum.com" },
    { "pattern": "itsnum.com/",         "zone_name": "itsnum.com" },
    // NOTE: "itsnum.com/" matches the bare root ONLY. itsnum.com/?signin=1 does not
    // match it and falls through to the older site worker, which serves a different
    // page. Cloudflare rejects "?" inside a route pattern (the API refuses the whole
    // route set), so there is no route-level fix. Hence /signin below: a real path
    // is routable, a query flag is not. Never put a "?" in a pattern here.
    // /sitemap.xml is claimed EXPLICITLY because num-biz-site (deployed 9 Aug,
    // source not in this repo) also answers it with an 8-URL list hardcoded in
    // its bundle. That list was silently the sitemap Google reads — 19 of our
    // 27 live pages, including every destination page, /vip/ and /hosts/, were
    // missing from it. An exact-path route beats a prefix route, so this line
    // is what makes public/sitemap.xml the real one. Do not remove it without
    // first checking what num-biz-site still serves.
    { "pattern": "itsnum.com/sitemap.xml", "zone_name": "itsnum.com" },
    // /business claimed EXPLICITLY, for exactly the same reason and by exactly
    // the same mechanism as /sitemap.xml above.
    //
    // 31 Aug 2026: `npm run mcp:integrity` reported six UNDOCUMENTED failures —
    // the published business page named none of the six MCP tools. It named
    // all six locally. `npx wrangler deploy` then said "No updated asset files
    // to upload", which was true and looked like a contradiction.
    //
    // It was not. www.itsnum.com/business/ served the correct 17,471-byte page
    // and itsnum.com/business/ served a 15,929-byte one with a different
    // <title>. Same worker, same config, two hostnames, two answers — because
    // num-biz-site (deployed 9 Aug, source not in this repo) holds a prefix
    // route on the apex and beats this file's itsnum.com/* catch-all. The
    // page anyone edits here was reaching almost nobody.
    //
    // BOTH spellings, because a route without a wildcard matches ONE exact URL
    // and /business and /business/ are two.
    //
    // Deliberately NOT "itsnum.com/business*": num-biz-site is the only thing
    // serving /business/pricing/, /business/verification/ and
    // /business/signup/ — all three are live, all three return 200, and none
    // of them exists in public/. A wildcard here would 404 the page businesses
    // sign up on. Claim the two URLs we can actually serve and leave the rest
    // where they are until that worker's source is found or its pages are
    // rehomed.
    { "pattern": "itsnum.com/business",  "zone_name": "itsnum.com" },
    { "pattern": "itsnum.com/business/", "zone_name": "itsnum.com" },
    { "pattern": "itsnum.com/signin*", "zone_name": "itsnum.com" },
    { "pattern": "itsnum.com/console*", "zone_name": "itsnum.com" },
    { "pattern": "itsnum.com/privacy*", "zone_name": "itsnum.com" },
    { "pattern": "itsnum.com/terms*",   "zone_name": "itsnum.com" },
    { "pattern": "itsnum.com/claim*",   "zone_name": "itsnum.com" },
    // The install page. Every share link, QR and invite points at /app, so this
    // route is load-bearing for growth — not a marketing extra.
    //
    // MUST be "/app*", not "/app". A route pattern is matched against the FULL
    // URL including the query string, so a bare "/app" matches only the naked
    // path — and "/app?ref=CODE", which is every referral link we hand out,
    // falls through to the old site worker and lands on the homepage. Same trap
    // as the "/" vs "/?signin=1" note above.
    { "pattern": "itsnum.com/app*",     "zone_name": "itsnum.com" },
    // The short link we hand out. /get redirects to /app with the query string
    // intact, so a shared referral still credits whoever sent it. Star for the
    // same reason as /app* above.
    { "pattern": "itsnum.com/get*",     "zone_name": "itsnum.com" },
    { "pattern": "itsnum.com/referral*", "zone_name": "itsnum.com" },
    // The paid-traffic landing page. Every travel ad points here, so the star is
    // load-bearing twice over: ad clicks always arrive with ?utm_source=... and
    // often ?ref=..., and a bare "/vip" would match neither.
    { "pattern": "itsnum.com/vip*",     "zone_name": "itsnum.com" },
    // /join is the spoken and printed alias. It redirects to /vip in the browser
    // and carries the query string across so attribution survives the hop.
    { "pattern": "itsnum.com/join*",    "zone_name": "itsnum.com" },
    // Num Tab, the merchant page for the QR/NFC table kit. Star for the same
    // reason as /vip*: this is an ad and print destination, so it arrives with
    // ?utm_source=... from paid traffic and from the codes themselves.
    { "pattern": "itsnum.com/tabs*",    "zone_name": "itsnum.com" },
    // Team-only preview of the consumer app prototype. noindex in the HTML,
    // linked from nowhere public — shared in #num for design review.
    { "pattern": "itsnum.com/app-preview*", "zone_name": "itsnum.com" }
  ]
}

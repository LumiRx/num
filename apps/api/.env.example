# NUM — Environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`. Use Doppler or Railway env vars in production.

# ----- App -----------------------------------------------------------
APP_ENV=development                # development | staging | production
APP_BASE_URL=https://num.local     # used to build QR landing URLs
LOG_LEVEL=INFO

# ----- LLM (Claude) --------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_CHAT=claude-sonnet-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# ----- Embeddings (OpenAI) ------------------------------------------
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ----- Twilio (SMS + WhatsApp) --------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ----- LINE Messaging API -------------------------------------------
LINE_CHANNEL_ID=...
LINE_CHANNEL_SECRET=...
LINE_CHANNEL_ACCESS_TOKEN=...

# ----- WeChat (Service Account) -------------------------------------
WECHAT_APP_ID=wx...
WECHAT_APP_SECRET=...
WECHAT_TOKEN=...                   # webhook signature token
WECHAT_AES_KEY=                    # optional, for encrypted messages

# ----- Supabase ------------------------------------------------------
SUPABASE_URL=https://txabrxbobyxznkgarpkc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # backend only — Supabase → Project Settings → API → service_role
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_DB_URL=postgresql://postgres:password@db.txabrxbobyxznkgarpkc.supabase.co:5432/postgres

# ----- Encryption (KMS) ---------------------------------------------
# v0: Supabase Vault. v1+: AWS KMS.
KMS_PROVIDER=supabase_vault        # supabase_vault | aws_kms
KMS_KEY_ID=                        # AWS only
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ----- Background workers (arq + Redis) -----------------------------
REDIS_URL=redis://localhost:6379/0

# ----- Observability -------------------------------------------------
SENTRY_DSN=
LOGFIRE_TOKEN=                     # optional, alt to Sentry

# ----- Payments (Phase 2) -------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OMISE_SECRET_KEY=                  # Thailand local cards / PromptPay

# ----- Multi-tenancy -------------------------------------------------
DEFAULT_PARTNER_TENANT_ID=         # uuid for the Phuket pilot tenant

# ----- 5arz human verification (Sprint 1) ---------------------------
SARZ_VERIFY_ENABLED=false          # flip true to turn on (off = NUM unchanged)
SARZ_AGENT_KEY=                    # arz_live_... NUM's 5arz agent API key
SARZ_API_URL=https://api.5arz.com
SARZ_VERIFY_URL=https://5arz.com/verify
SARZ_SETTLEMENT_ENABLED=false      # Sprint 3 — mint 5arz Agent-Tx-Binding on settlement
